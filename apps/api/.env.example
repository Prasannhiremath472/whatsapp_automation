# --- Milestone 1: required, actively used ---

# MySQL connection string. Native Windows MySQL 8.0 install (no Docker).
# Switched from PostgreSQL because the target hosting (Hostinger) only
# supports MySQL. Port is the MySQL default, 3306.
DATABASE_URL="mysql://root:your_password@localhost:3306/whatsapp_crm_dev"

# Secrets used to sign the access/refresh JWTs. Use long random values in
# real environments; these are dev-only placeholders.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# HTTP port the Nest app listens on.
PORT=3000

# --- Milestone 2: WhatsApp webhook + router + mock provider ---

# "mock" (default) uses the in-memory fake WhatsApp provider — no real Meta
# credentials needed, safe for local dev. "live" uses the real Cloud API
# provider and requires META_APP_ID/META_APP_SECRET below.
WHATSAPP_MODE=mock

# Meta/WhatsApp Cloud API app credentials. Only required when WHATSAPP_MODE=live.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# Shared platform-level webhook verify token used for the GET /webhook
# handshake. Meta's webhook subscription is one app-level URL (not
# per-tenant), so this single token is what Meta echoes back during
# subscription setup — see webhook.controller.ts for details.
META_WEBHOOK_VERIFY_TOKEN=dev-webhook-verify-token

# Redis connection string. Backs the BullMQ "webhook-events" queue as of M2.
REDIS_URL="redis://localhost:6379"

# --- Future milestones: declared now, unused until then ---

# M5+ (automation) LLM provider mode. Not read yet.
LLM_MODE=

# M6+ (billing) billing provider mode. Not read yet.
BILLING_MODE=
