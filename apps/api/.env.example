# --- Core ---

# MySQL connection string (MySQL 8). For local dev use the docker-compose
# service (port 3307) or your own MySQL on 3306. Hostinger only offers MySQL.
DATABASE_URL="mysql://genie:genie@localhost:3307/whatsapp_crm_dev"

# Secrets used to sign the access/refresh JWTs. Use long random values in
# real environments; these are dev-only placeholders.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# HTTP port the Nest app listens on. The REST API is served under /api/v1.
PORT=3000

# Comma-separated browser origins allowed to call the API (user app, admin app).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- WhatsApp ---

# "mock" (default) uses the in-memory fake WhatsApp provider — no real Meta
# credentials needed, safe for local dev. "live" uses the real Cloud API
# provider and requires META_APP_ID/META_APP_SECRET below.
WHATSAPP_MODE=mock

# Meta/WhatsApp Cloud API app credentials. Only required when WHATSAPP_MODE=live.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# Shared platform-level webhook verify token used for the GET /webhook
# handshake. Meta's webhook subscription is one app-level URL (not
# per-tenant), so this single token is what Meta echoes back during
# subscription setup — see webhook.controller.ts for details.
META_WEBHOOK_VERIFY_TOKEN=dev-webhook-verify-token

# Key used to encrypt WhatsApp access tokens at rest (AES-256-GCM):
# 32 random bytes as 64 hex characters. REQUIRED to connect a WhatsApp
# account. Generate with:  openssl rand -hex 32
# Never commit a real value; losing it means customers must reconnect.
ENCRYPTION_KEY=

# --- Bulk messaging ---

# Redis backs the BullMQ queues (webhook events, campaign sending).
# docker-compose maps Redis to 6380; use 6379 for a Redis/Memurai installed locally.
REDIS_URL="redis://localhost:6380"

# Maximum campaign messages sent per second per campaign. Meta's default
# ceiling is 80/s per number; stay well under it.
BROADCAST_RATE_PER_SECOND=20

# In mock mode, simulate delivered/read receipts so campaign stats move.
MOCK_AUTO_ACK=true

# --- Future milestones: declared now, unused until then ---

# M5+ (automation) LLM provider mode. Not read yet.
LLM_MODE=

# M6+ (billing) billing provider mode. Not read yet.
BILLING_MODE=
